# Committed build outputs. They are checked in because neither the Docker
# build nor `esphome compile` has Node, and CI fails on a stale copy — but
# nobody reviews them, and a one-line source change rewrites the whole file.
#
#   linguist-generated  collapses the file in GitHub diffs and keeps it out
#                       of the repository's language statistics
#   -diff               git prints "Binary files differ" instead of the body,
#                       so it stops dominating `git diff --stat` line counts
#   -merge              two branches that both regenerate this conflict on the
#                       whole file rather than line-merging into a plausible
#                       but corrupt result. Regenerate it
#                       (cd web && npm run build:dashboard) instead of
#                       resolving it by hand.
esphome/components/ct002/dashboard_asset.h linguist-generated=true -diff -merge
src/astrameter/static/dashboard.html linguist-generated=true -diff -merge

# Generated from fixtures/protocol_golden_vectors.json by
# _gen_protocol_test_vectors.py. Readable, and small enough to diff, so only
# the review-noise half applies.
tests/components/ct002/host_protocol_test_vectors.h linguist-generated=true

# Screenshots for the docs and the landing page, regenerated by
# `cd web && npm run screenshots`. Already binary to git; this keeps them out
# of the diff view too.
docs/images/*.png linguist-generated=true

# Resolved by `uv lock`, so it is generated — but a dependency bump is worth
# reading (that is how a CVE fix shows up), so the diff stays on.
uv.lock linguist-generated=true
